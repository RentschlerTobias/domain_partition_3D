FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.067747;

boundaryField
{
    RU_HUB
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
    RU_SHROUD
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
    RU_INLET
    {
        type            calculated;
        value           uniform 0;
    }
    RU_OUTLET
    {
        type            calculated;
        value           uniform 0;
    }
    RU_PERIOPS
    {
        type            cyclicAMI;
        value           uniform 0.067747;
    }
    RU_PERIOSS
    {
        type            cyclicAMI;
        value           uniform 0.067747;
    }
    RU_BLADE
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
    defaultFaces
    {
        type            empty;
    }
}


