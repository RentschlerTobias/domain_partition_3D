#!/usr/bin/env python3
"""Probe: local collapse of adjacent singular pairs in a 3D hex mesh."""

import argparse
import json
import sys
import time
from collections import defaultdict
from pathlib import Path

import numpy as np

REPO = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(REPO / "experimentell" / "hex3d_algohex"))

import base_complex as bc
import ovm_io

HE = bc.HEX_EDGES


def _parallel(P, e1, e2):
    a = P[e1[1]] - P[e1[0]]
    b = P[e2[1]] - P[e2[0]]
    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)
    if na < 1e-12 or nb < 1e-12:
        return False
    cos = float(np.dot(a, b) / (na * nb))
    return abs(cos) > 0.9


def _min_endpoint_dist(P, e1, e2):
    d = 1e18
    for u in e1:
        for v in e2:
            d = min(d, float(np.linalg.norm(P[u] - P[v])))
    return d


def detect_singular(P, H, interior_only=True):
    f2h, e2h = bc.build_topology(H)
    sing = bc.singular_edges(H, P, f2h, e2h, interior_only=interior_only)
    return f2h, e2h, sing


def detect_pairs(P, H, interior_only=True):
    t_start = time.time()
    f2h, e2h, sing = detect_singular(P, H, interior_only=interior_only)
    sing_set = sing
    
    # Build hex edges
    hex_edges = []
    for hi, c in enumerate(H):
        es = []
        for a, b in HE:
            u, v = int(c[a]), int(c[b])
            es.append((min(u, v), max(u, v)))
        hex_edges.append(es)
    
    cand = set()
    # Strategy 1: pairs within same hex - bucket by hex
    for hi, es in enumerate(hex_edges):
        # Get singular edges in this hex
        ses = []
        for e in es:
            if e in sing_set:
                ses.append(e)
        m = len(ses)
        for i in range(m):
            e1 = ses[i]
            for j in range(i + 1, m):
                e2 = ses[j]
                if e1 == e2:
                    continue
                # disjoint check
                # e1,e2 tuples
                if e1[0] in e2 or e1[1] in e2:
                    continue
                if _parallel(P, e1, e2):
                    cand.add(frozenset((e1, e2)))
    
    # Strategy 2: pairs across face-adjacent hexes
    for f, hs in f2h.items():
        if len(hs) != 2:
            continue
        h0, h1 = hs[0], hs[1]
        # Only check singular edges
        for e1 in hex_edges[h0]:
            if e1 not in sing_set:
                continue
            for e2 in hex_edges[h1]:
                if e2 not in sing_set:
                    continue
                if e1 == e2:
                    continue
                if e1[0] in e2 or e1[1] in e2:
                    continue
                if _parallel(P, e1, e2):
                    cand.add(frozenset((e1, e2)))
    
    out = []
    for c in cand:
        e1, e2 = tuple(c)
        out.append((e1, e2, _min_endpoint_dist(P, e1, e2)))
    out.sort(key=lambda x: x[2])
    t_end = time.time()
    print(f"[singular_pair] detect_pairs took {t_end-t_start:.2f}s, found {len(out)} pairs", flush=True)
    return out, sing_set, f2h, e2h
